{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kinic-wiki-browser",
  "account_id": "9029b5f9de5b2e820eaf4ed562bcb0e7",
  "main": "src/server.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "VITE_WIKI_IC_HOST": "https://icp0.io",
    "VITE_KINIC_WIKI_CANISTER_ID": "6emaw-iyaaa-aaaay-aacka-cai",
    "KINIC_WIKI_CANISTER_ID": "6emaw-iyaaa-aaaay-aacka-cai",
    "KINIC_WIKI_GENERATOR_URL": "https://wiki-generator.kinic.xyz"
  },
  "r2_buckets": [
    {
      "binding": "LINK_PREVIEW_IMAGES",
      "bucket_name": "kinic-wiki-link-preview-images"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "LINK_PREVIEW_QUEUE",
        "queue": "kinic-wiki-generation"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "QUERY_ANSWER_RATE_LIMIT",
      "id": "72995eb374a14e71b1a35a545beca160"
    }
  ],
  "routes": [
    {
      "pattern": "kinic.xyz",
      "custom_domain": true
    },
    {
      "pattern": "wiki.kinic.xyz",
      "custom_domain": true
    }
  ],
  "env": {
    "staging": {
      "name": "kinic-wiki-browser-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "KINIC_DEPLOYMENT_ENV": "staging",
        "VITE_WIKI_IC_HOST": "https://icp0.io",
        "VITE_KINIC_WIKI_CANISTER_ID": "3ryrw-kyaaa-aaaaf-qgxpq-cai",
        "KINIC_WIKI_CANISTER_ID": "3ryrw-kyaaa-aaaaf-qgxpq-cai",
        "VITE_II_DERIVATION_ORIGIN": "https://3ryrw-kyaaa-aaaaf-qgxpq-cai.icp0.io",
        "KINIC_WIKI_GENERATOR_URL": ""
      },
      "r2_buckets": [
        {
          "binding": "LINK_PREVIEW_IMAGES",
          "bucket_name": "kinic-wiki-link-preview-images-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "LINK_PREVIEW_QUEUE",
            "queue": "kinic-wiki-generation-staging"
          }
        ]
      },
      "kv_namespaces": [
        {
          "binding": "QUERY_ANSWER_RATE_LIMIT",
          "id": "dd821e7a3e4f4f908df20c2cb17abc2d"
        }
      ]
    }
  }
}
