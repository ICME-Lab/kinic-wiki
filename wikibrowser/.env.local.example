# Local icp network:
VITE_WIKI_IC_HOST=http://127.0.0.1:8001
VITE_II_PROVIDER_URL=http://id.ai.localhost:8001
VITE_KINIC_WIKI_CANISTER_ID=<local-wiki-canister-id>

# Mainnet / Cloudflare Workers:
# VITE_WIKI_IC_HOST=https://icp0.io
# VITE_II_PROVIDER_URL=https://id.ai
# VITE_KINIC_WIKI_CANISTER_ID=<mainnet-wiki-canister-id>

# Ops Q&A server secret. Never prefix this with VITE_.
DEEPSEEK_API_KEY=<deepseek-api-key>
# Play App Signing certificate SHA-256 fingerprint (uppercase, colon-delimited).
KINIC_ANDROID_APP_LINK_SHA256_CERT_FINGERPRINT=
