+// GHSA-fc5q-39xc-vjpf: a wildcard inside an outer repetition introduces
+// another unbounded quantifier, even when there is only one branch. Keep
+// quoted/escaped stars and character classes bounded. Safe nested star
+// sequences are still simplified by the existing analysis before this guard.
+const hasUnboundedWildcard = (input, options) => {
+  let quoted = false;
+  for (let i = 0; i < input.length; i++) {
+    const ch = input[i];
+    if (ch === '\\') { i++; continue; }
+    if (ch === '"') { quoted = !quoted; continue; }
+    if (quoted) continue;
+    if (ch === '[' && options.nobracket !== true) {
+      let end = i + 1;
+      if (input[end] === '^' || (options.posix === true && input[end] === '!')) end++;
+      if (input[end] === ']') end++;
+      for (; end < input.length; end++) {
+        if (input[end] === '\\') { end++; continue; }
+        if (input[end] === '[' && input[end + 1] === ':' && options.posix !== false) {
+          const close = input.indexOf(':]', end + 2);
+          if (close !== -1 && Object.prototype.hasOwnProperty.call(POSIX_REGEX_SOURCE, input.slice(end + 2, close))) { end = close + 1; continue; }
+        }
+        if (input[end] === ']') break;
+      }
+      if (end < input.length) { i = end; continue; }
+    }
+    if (ch === '*') return true;
+  }
+  return false;
+};
