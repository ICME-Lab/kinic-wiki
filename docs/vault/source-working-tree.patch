+fn restore_transaction<T>(
+    vault: &[u8],
+    attempt: Option<&[u8]>,
+    apply: impl FnOnce(&Connection, u64) -> Result<T>,
+) -> Result<T> {
+    transaction(|db| {
+        store::authorize(db, caller())?;
+        let t = now();
+        let h = store::pending(db, vault, t)?;
+        store::setup::check_attempt(db, &h, attempt)?;
+        apply(db, t)
+    })
+}
+
+#[update]
+fn begin_restore_revision(vault: Id, revision: Revision, attempt: Option<Id>) -> Result<()> {
+    restore_transaction(&vault, attempt.as_deref(), |db, t| {
+        store::restore::stage(db, &vault, revision, t)
+    })
+}
+
+#[update]
+fn put_restore_chunk(vault: Id, index: u32, data: Vec<u8>, attempt: Option<Id>) -> Result<()> {
+    restore_transaction(&vault, attempt.as_deref(), |db, t| {
+        store::restore::put(db, &vault, index, &data, t)
+    })
+}
+
+#[update]
+fn commit_restore_revision(
+    vault: Id,
+    sequence: u64,
+    attempt: Option<Id>,
+) -> Result<RestoreProgress> {
+    restore_transaction(&vault, attempt.as_deref(), |db, t| {
+        store::restore::finish_record(db, &vault, sequence, t)
     })
 }
