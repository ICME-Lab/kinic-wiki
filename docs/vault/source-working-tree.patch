+        content::begin(&db, one.clone(), 10).unwrap();
+        content::begin(&db, two.clone(), 10).unwrap();
+        let reservations = content::quota(&db, &a).unwrap().reserved;
+        db.execute("DELETE FROM uploads", params![]).unwrap();
