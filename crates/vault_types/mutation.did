type Activate = record {
  normal : Envelope;
  attempt : opt blob;
  vault : blob;
  registration : opt text;
  assertion : opt text;
  operation : blob;
  recovery : Envelope;
};
type BeginRevision = record {
  object : blob;
  vault : blob;
  chunk_hashes : vec blob;
  operation : blob;
  manifest : blob;
  plain_size : nat64;
  expected_revision : nat64;
};
type CleanupAction = variant {
  AbortExport : record { export : blob };
  CancelUpload : record { upload : blob };
  Purge;
  CancelIncident : record { vector_digest : blob; incident : blob };
  Expired;
  CancelSetup : record { attempt : blob };
};
type CredentialScope = variant { Global; Instances : vec Instance };
type Derive = record {
  attempt : opt blob;
  vault : blob;
  transport : blob;
  epoch : nat64;
  assertion : opt text;
};
type Envelope = record { ciphertext : blob; version : nat8; nonce : blob };
type Generation = record {
  vault : blob;
  owner : principal;
  epoch : nat64;
  version : nat8;
  canister : principal;
  nonce : blob;
  key_name : text;
};
type IncidentBackupAck = record {
  archive_length : nat64;
  archive_hash : blob;
  descriptor_digest : blob;
  recovery_verifier : blob;
  sequence : nat64;
  commitment : blob;
};
type IncidentDerive = record {
  job : blob;
  attempt : blob;
  role : IncidentRole;
  transport : blob;
  generation : Generation;
};
type IncidentRole = variant { Source; Target };
type IncidentWrapper = record {
  wrapper : blob;
  object : blob;
  source_digest : blob;
  revision : nat64;
  sequence : nat64;
};
type Instance = record { vault : blob; nonce : blob };
type Mutation = record {
  counter : nat64;
  owner : principal;
  version : nat8;
  grant : blob;
  canister : principal;
  operation : MutationOperation;
};
type MutationOperation = variant {
  RestoreCommitRecord : record { sequence : nat64 };
  PutChunk : record { vault : blob; data : blob; upload : blob; index : nat32 };
  RestoreActivate;
  IncidentStage : record {
    normal : Envelope;
    attempt : blob;
    vault : blob;
    recovery_verifier : blob;
    recovery : Envelope;
  };
  IncidentStart;
  IncidentDerive : IncidentDerive;
  BeginRegistration : record { vault : blob; scope : CredentialScope };
  CreateEmptyDerive : IncidentDerive;
  CommitRevision : record { vault : blob; upload : blob };
  RestoreDiscard : record { cursor : nat64; current : Generation };
  KeyResult : record { handle : blob };
  DeleteObject : record {
    object : blob;
    vault : blob;
    operation : blob;
    expected_revision : nat64;
  };
  RegisterCredential : record {
    vault : blob;
    registration : text;
    scope : CredentialScope;
  };
  RestoreDerive : IncidentDerive;
  CreateEmptyStage : record {
    normal : Envelope;
    recovery_verifier : blob;
    recovery : Envelope;
  };
  CreateEmptyAllocate;
  RestoreChunk : record { data : blob; index : nat32 };
  RestorePreflight : RestorePreflight;
  IncidentPrepareExport : record {
    attempt : blob;
    vault : blob;
    export : blob;
  };
  IncidentCancel;
  Cleanup : record { job : blob; action : CleanupAction; cursor : nat64 };
  RestoreBeginImport;
  IncidentReset : record { attempt : blob; vault : blob; next_attempt : blob };
  RestoreCancel : record { cursor : nat64 };
  IncidentConfirmBackup : record {
    ack : IncidentBackupAck;
    attempt : blob;
    vault : blob;
  };
  IncidentCutover : record { digest : blob };
  CreateEmptyConfirmKit : record { envelope_digest : blob };
  Derive : Derive;
  RestoreStage : record {
    normal : Envelope;
    recovery_verifier : blob;
    recovery : Envelope;
  };
  Create : Reserve;
  IncidentConfirmKit : record {
    attempt : blob;
    vault : blob;
    envelope_digest : blob;
  };
  CreateEmptyActivate;
  Activate : record { request : Activate; recovery_verifier : blob };
  IncidentWrap : record {
    after : nat64;
    attempt : blob;
    vault : blob;
    rows : vec IncidentWrapper;
  };
  PurgeObject : record { object : blob; vault : blob };
  RestoreAllocate;
  RestoreRecord : Revision;
  RestoreConfirmBackup : IncidentBackupAck;
  IncidentAllocate : record { attempt : blob; vault : blob };
  RestoreConfirmKit : record { envelope_digest : blob };
  ClearInactive : record { vault : blob };
  BeginRevision : BeginRevision;
  RemoveCredential : record { credential : blob };
  CancelSetup : record { attempt : blob; vault : blob };
};
type Reserve = record { vault : blob; operation : blob };
type RestorePreflight = record {
  records : nat64;
  peak_pending_bytes : nat64;
  source_saved : bool;
  current_plain_bytes : nat64;
  archive_length : nat64;
  archive_digest : blob;
  plain_bytes : nat64;
  objects : nat64;
  source_fully_verified : bool;
  target_commitment : blob;
  source_commitment : blob;
  revision_bytes : nat64;
  chunks : nat64;
  sequence : nat64;
};
type Revision = record {
  deleted : bool;
  object : blob;
  vault : blob;
  chunk_hashes : vec blob;
  revision : nat64;
  manifest : blob;
  plain_size : nat64;
  sequence : nat64;
};
service : { encode : (Mutation) -> () }