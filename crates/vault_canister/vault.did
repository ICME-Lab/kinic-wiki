type AccessRole = variant { Viewer; Editor; Owner };
type AccountInitialization = record { balance : nat64; grant_cycles : nat64 };
type Action = variant {
  CancelUpload : record { job : blob; vault : blob; upload : blob };
  PutChunk : record { upload : blob; bytes : blob; index : nat32 };
  CommitRevision : record { upload : blob };
  DeleteObject : record {
    object : blob;
    vault : blob;
    expected_revision : nat64;
  };
  RenameVault : record { vault : blob; name : text; expected_sequence : nat64 };
  DeleteVault : record { vault : blob };
  Collect;
  PurgeObject : record {
    object : blob;
    vault : blob;
    expected_revision : nat64;
  };
  SaveInline : SaveInline;
  BeginRevision : BeginRevision;
};
type BeginRevision = record {
  object : blob;
  vault : blob;
  chunk_hashes : vec blob;
  operation : blob;
  manifest : blob;
  plain_size : nat64;
  expected_revision : nat64;
};
type BridgeConfig = record {
  daily_limit_cycles : nat64;
  peer : principal;
  physical_reserve_cycles : nat64;
  enabled : bool;
};
type BridgeError = variant {
  Storage;
  InvalidInput;
  Disabled;
  NotFound;
  Unauthorized;
  Capacity;
  Unavailable;
  Expired;
  Conflict;
};
type BridgeRevocation = record {
  through_generation : nat64;
  vault_owner : principal;
};
type CommittedUpload = record {
  object : blob;
  vault : blob;
  revision : nat64;
  sequence : nat64;
};
type CreateVault = record { operation : blob };
type CreditOffer = record {
  wiki_owner : principal;
  link_generation : nat64;
  operation : blob;
  amount_cycles : nat64;
  vault_owner : principal;
  expires_at_ns : nat64;
};
type CreditReceipt = record { status : CreditStatus; offer : CreditOffer };
type CreditStatus = variant { Prepared; Accepted; NotAccepted };
type DeriveKey = record { vault : blob; transport : blob; operation : blob };
type Error = variant {
  Storage;
  InvalidInput;
  Busy;
  KeyService;
  NotFound;
  Unauthorized;
  Expired;
  QuotaExceeded;
  Conflict;
};
type FundingConfig = record {
  recipient : principal;
  cycles_per_kinic : nat64;
  ledger : principal;
};
type GlobalCapacity = record {
  used : nat64;
  overcommitted : bool;
  limit : nat64;
  overage : nat64;
  accounting_reserved : nat64;
};
type Header = record {
  id : blob;
  public_key : blob;
  // Owner-visible display metadata, deliberately separate from the key context.
  name : opt text;
  state : VaultState;
  nonce : blob;
  key_name : text;
  sequence : nat64;
};
type HttpRequest = record {
  url : text;
  method : text;
  body : blob;
  headers : vec record { text; text };
  certificate_version : opt nat16;
};
type HttpResponse = record {
  body : blob;
  headers : vec record { text; text };
  upgrade : opt bool;
  status_code : nat16;
};
type Icrc10SupportedStandard = record { url : text; name : text };
type Icrc21ConsentInfo = record {
  metadata : Icrc21ConsentMessageMetadata;
  consent_message : Icrc21ConsentMessage;
};
type Icrc21ConsentMessage = variant { GenericDisplayMessage : text };
type Icrc21ConsentMessageMetadata = record {
  utc_offset_minutes : opt int16;
  language : text;
};
type Icrc21ConsentMessageRequest = record {
  arg : blob;
  method : text;
  user_preferences : Icrc21ConsentMessageSpec;
};
type Icrc21ConsentMessageResponse = variant {
  Ok : Icrc21ConsentInfo;
  Err : Icrc21Error;
};
type Icrc21ConsentMessageSpec = record {
  metadata : Icrc21ConsentMessageMetadata;
  device_spec : opt Icrc21DeviceSpec;
};
type Icrc21DeviceSpec = variant { GenericDisplay; FieldsDisplay };
type Icrc21Error = variant {
  GenericError : Icrc21GenericError;
  InsufficientPayment : Icrc21ErrorInfo;
  UnsupportedCanisterCall : Icrc21ErrorInfo;
  ConsentMessageUnavailable : Icrc21ErrorInfo;
};
type Icrc21ErrorInfo = record { description : text };
type Icrc21GenericError = record { description : text; error_code : nat };
type KeyReply = record {
  encrypted_key : blob;
  public_key : blob;
  input : blob;
};
type KeyRetrievalCost = record {
  fee : nat64;
  owner_fee : nat64;
  first_key_free : bool;
};
type LinkChallenge = record {
  challenge : blob;
  generation : nat64;
  vault_owner : principal;
  expires_at_ns : nat64;
};
type LinkProof = record { wiki_owner : principal; challenge : LinkChallenge };
type LinkStatus = record {
  wiki_owner : principal;
  active : bool;
  generation : nat64;
  vault_owner : principal;
};
type Mutation = record { action : Action; operation : blob };
type MutationResult = variant {
  Collected : nat64;
  Done;
  Progress : bool;
  Revision : Revision;
  Upload : Upload;
};
type ObjectPage = record { next : opt blob; entries : vec Revision };
type Payment = record {
  fee : nat64;
  status : Status;
  credits : nat64;
  // True only while the durable operation is known not to have dispatched a debit.
  preparing : bool;
  attempt : nat64;
  request : PurchaseRequest;
  memo : blob;
  generation : int64;
  uncertain : bool;
  sent_at : nat64;
  wallet : principal;
  created_at_time : nat64;
  config : FundingConfig;
  reconciliation : opt ReconciliationState;
};
type PendingUpload = record {
  expires : nat64;
  request : BeginRevision;
  cancel_job : opt blob;
  received : vec nat32;
};
// Bounded owner-only metadata; no document name or plaintext.
type PendingUploadSummary = record {
  expires : nat64;
  vault : blob;
  upload : blob;
  cancel_job : opt blob;
};
type PendingUploads = record {
  next : opt blob;
  entries : vec PendingUploadSummary;
};
type PurchaseRequest = record {
  beneficiary : principal;
  amount_e8s : nat64;
  operation : blob;
  min_credits : nat64;
  created_at_time : nat64;
};
type Quota = record {
  "reserved" : nat64;
  limit : nat64;
  current : nat64;
  charged : nat64;
};
type ReconciliationProgress = record {
  end : nat;
  next : nat;
  can_continue : bool;
  scanned : nat64;
  payment : Payment;
};
type ReconciliationState = record {
  end : nat64;
  next : nat64;
  lease : nat64;
  start : nat64;
  lease_until : nat64;
  spender : principal;
  lease_generation : int64;
};
type RefillResult = variant { Ok : nat; Err : text };
type RefillResult_1 = variant { Ok; Err : text };
type Result = variant { Ok : nat64; Err : Error };
type Result_1 = variant { Ok; Err : BridgeError };
type Result_10 = variant { Ok : blob; Err : Error };
type Result_11 = variant { Ok : opt VaultConfig; Err : Error };
type Result_12 = variant { Ok : opt FundingConfig; Err : Error };
type Result_13 = variant { Ok : Revision; Err : Error };
type Result_14 = variant { Ok : Quota; Err : Error };
type Result_15 = variant { Ok : SpendingStatus; Err : Error };
type Result_16 = variant { Ok : UploadStatus; Err : Error };
type Result_17 = variant { Ok : VaultAccess; Err : Error };
type Result_18 = variant { Ok : GlobalCapacity; Err : Error };
type Result_19 = variant { Ok : AccountInitialization; Err : Error };
type Result_2 = variant { Ok : LinkChallenge; Err : BridgeError };
type Result_20 = variant { Ok : VaultAccessPage; Err : Error };
type Result_21 = variant { Ok : RevisionPage; Err : Error };
type Result_22 = variant { Ok : ObjectPage; Err : Error };
type Result_23 = variant { Ok : PendingUploads; Err : Error };
type Result_24 = variant { Ok : vec VaultMember; Err : Error };
type Result_25 = variant { Ok : vec Header; Err : Error };
type Result_26 = variant { Ok : MutationResult; Err : Error };
type Result_27 = variant { Ok : CreditReceipt; Err : BridgeError };
type Result_28 = variant { Ok; Err : Error };
type Result_29 = variant { Ok : BridgeRevocation; Err : BridgeError };
type Result_3 = variant { Ok : Payment; Err : Error };
type Result_30 = variant { Ok : KeyRetrievalCost; Err : Error };
type Result_31 = variant { Ok : opt LinkStatus; Err : BridgeError };
type Result_4 = variant { Ok : opt Payment; Err : Error };
type Result_5 = variant { Ok : vec Payment; Err : Error };
type Result_6 = variant { Ok : ReconciliationProgress; Err : Error };
type Result_7 = variant { Ok : LinkProof; Err : BridgeError };
type Result_8 = variant { Ok : Header; Err : Error };
type Result_9 = variant { Ok : KeyReply; Err : Error };
type Revision = record {
  deleted : bool;
  object : blob;
  vault : blob;
  chunk_hashes : vec blob;
  revision : nat64;
  manifest : blob;
  plain_size : nat64;
  sequence : nat64;
};
type RevisionPage = record { next : opt nat64; entries : vec Revision };
// One bounded, atomic revision using the unlocked immutable key context.
type SaveInline = record {
  request : BeginRevision;
  bytes : blob;
  context_hash : blob;
};
// Advisory admission for new paid work. Request-specific costs and limits still apply.
type SpendingStatus = variant {
  AccountCreditLow;
  Available;
  ServiceReserveLow;
  Unconfigured;
};
type Status = variant {
  Quoted;
  InsufficientAllowance;
  Paid : nat64;
  BadFee : nat64;
  Rejected;
  InFlight;
  Unknown;
  Expired;
  InsufficientFunds;
};
type Upload = record { id : blob; expires : nat64; revision : nat64 };
type UploadStatus = variant {
  Committed : CommittedUpload;
  Absent;
  Cancelled;
  Expired;
  Pending : PendingUpload;
};
type VaultAccess = record {
  owner : principal;
  role : AccessRole;
  header : Header;
};
type VaultAccessPage = record { next : opt blob; entries : vec VaultAccess };
type VaultConfig = record { minimum_cycles : nat64; key_name : text };
type VaultMember = record { "principal" : principal; role : AccessRole };
type VaultState = variant { Deleting; Active; Pending };
service : () -> {
  account_balance : () -> (Result) query;
  acknowledge_wiki_credit : (CreditOffer) -> (Result_1);
  acknowledge_wiki_link : (LinkProof) -> (Result_1);
  begin_wiki_link : (blob) -> (Result_2);
  // The beneficiary withdraws an unpaid quote its payer signed. This never moves funds.
  beneficiary_cancel_quote : (principal, blob) -> (Result_3);
  // The beneficiary submits a quote its payer signed. The payer's quote fixes the
  // amount, recipient and beneficiary, and its ICRC-2 allowance bounds the debit,
  // so the payer does not need to sign this dispatch as well.
  beneficiary_pay_purchase : (principal, blob) -> (Result_3);
  // The beneficiary reads a payment funded by an external wallet without that wallet's signature.
  beneficiary_payment_status : (principal, blob) -> (Result_4) query;
  // The wallet's 16 most recent payments, keeping only those whose beneficiary is the caller.
  beneficiary_payments : (principal) -> (Result_5) query;
  // The beneficiary checks ledger history for its payer's operation. A scan never
  // sends a transfer; it only credits a transfer the ledger already recorded.
  beneficiary_reconcile_purchase : (principal, blob) -> (Result_6);
  cancel_quote : (blob) -> (Result_3);
  consume_wiki_link : (blob, principal) -> (Result_7);
  create_vault : (CreateVault) -> (Result_8);
  cycles_balance_for_wiki : () -> (RefillResult);
  derive_vault_key : (DeriveKey) -> (Result_9);
  get_chunk : (blob, blob, nat64, nat32) -> (Result_10);
  get_config : () -> (Result_11);
  get_funding_config : () -> (Result_12) query;
  get_manifest : (blob, blob, nat64) -> (Result_13);
  get_quota : (blob) -> (Result_14);
  get_spending_status : () -> (Result_15);
  get_upload_status : (blob) -> (Result_16);
  get_vault_access : (blob) -> (Result_17);
  get_vault_header : (blob) -> (Result_8);
  global_capacity : () -> (Result_18) query;
  http_request : (HttpRequest) -> (HttpResponse) query;
  icrc10_supported_standards : () -> (vec Icrc10SupportedStandard) query;
  icrc21_canister_call_consent_message : (Icrc21ConsentMessageRequest) -> (
      Icrc21ConsentMessageResponse,
    );
  initialize_vault_account : () -> (Result_19);
  inspect_wiki_link : (blob) -> (Result_2);
  list_accessible_vaults : (blob) -> (Result_20);
  list_history : (blob, blob, nat64) -> (Result_21);
  list_objects : (blob, blob) -> (Result_22);
  list_payments : () -> (Result_5) query;
  list_pending_uploads : (blob) -> (Result_23);
  list_vault_members : (blob) -> (Result_24);
  list_vaults : () -> (Result_25);
  mutate : (Mutation) -> (Result_26);
  pay_purchase : (blob) -> (Result_3);
  payment_status : (blob) -> (Result_4) query;
  prepare_wiki_credit : (blob) -> (Result_27);
  quote_purchase : (PurchaseRequest) -> (Result_3);
  receive_wiki_credit : (CreditOffer) -> (Result_27);
  reconcile_purchase : (blob) -> (Result_6);
  remove_vault_member : (blob, principal) -> (Result_28);
  revoke_wiki_link : () -> (Result_29);
  set_config : (opt VaultConfig) -> (Result_28);
  set_cycles_refill_source : (opt principal) -> (RefillResult_1);
  set_funding_config : (opt FundingConfig) -> (Result_28);
  set_vault_member : (blob, principal, AccessRole) -> (Result_28);
  set_wiki_bridge_config : (BridgeConfig) -> (Result_1);
  shared_derive_vault_key : (DeriveKey) -> (Result_9);
  shared_get_chunk : (blob, blob, nat64, nat32) -> (Result_10);
  shared_get_manifest : (blob, blob, nat64) -> (Result_13);
  shared_get_quota : (blob) -> (Result_14);
  shared_get_upload_status : (blob, blob) -> (Result_16);
  shared_list_history : (blob, blob, nat64) -> (Result_21);
  shared_list_objects : (blob, blob) -> (Result_22);
  shared_list_pending_uploads : (blob, blob) -> (Result_23);
  shared_mutate : (blob, Mutation) -> (Result_26);
  vault_key_cost : (opt text) -> (Result_30) query;
  wiki_bridge_config : () -> (opt BridgeConfig) query;
  wiki_credit_status : (CreditOffer) -> (Result_27);
  wiki_link_status : () -> (Result_31);
}