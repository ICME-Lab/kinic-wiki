{
  "name": "kinic-wiki-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev --port 8791",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.worker.config.ts && node --test tests/*.node-test.mjs",
    "build": "cf deploy --dry-run",
    "cf-typegen": "node ../../scripts/cloudflare/types.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:live:readonly": "vitest run --config vitest.readonly-live.config.ts",
    "test:live:private": "vitest run --config vitest.private-live.config.ts"
  },
  "dependencies": {
    "@icp-sdk/core": "6.0.0",
    "@kinic/ii-server": "workspace:*",
    "@kinic/jev-reranker": "workspace:*",
    "openai": "7.15.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260921.1",
    "@cloudflare/vitest-pool-workers": "0.20.2",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.136.0",
    "cf": "1.0.0-beta.2"
  }
}
