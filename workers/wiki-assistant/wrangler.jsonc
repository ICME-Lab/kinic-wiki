{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kinic-wiki-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "ASSISTANT_ENABLED": "false",
    "ASSISTANT_INVITED_PRINCIPALS": "[]",
    "ASSISTANT_LIMITS": "{}",
    "KINIC_WIKI_CANISTER_ID": "6emaw-iyaaa-aaaay-aacka-cai",
    "ASSISTANT_ORIGIN": "https://wiki.kinic.xyz",
    "ASSISTANT_DERIVATION_ORIGIN": "https://6emaw-iyaaa-aaaay-aacka-cai.icp0.io"
  },
  "durable_objects": { "bindings": [
    { "name": "ASSISTANT_AUTH", "class_name": "AssistantAuth" },
    { "name": "ASSISTANT_USERS", "class_name": "AssistantUser" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AssistantAuth", "AssistantUser"] }],
  "unsafe": { "bindings": [{ "name": "AUTH_RATE_LIMIT", "type": "ratelimit", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } }] },
  "env": { "staging": {
    "name": "kinic-wiki-assistant-staging",
    "vars": {
      "ASSISTANT_ENABLED": "false", "ASSISTANT_INVITED_PRINCIPALS": "[]", "ASSISTANT_LIMITS": "{}",
      "KINIC_WIKI_CANISTER_ID": "3ryrw-kyaaa-aaaaf-qgxpq-cai",
      "ASSISTANT_ORIGIN": "https://kinic-wiki-browser-staging.hude.workers.dev",
      "ASSISTANT_DERIVATION_ORIGIN": "https://3ryrw-kyaaa-aaaaf-qgxpq-cai.icp0.io"
    },
    "durable_objects": { "bindings": [
      { "name": "ASSISTANT_AUTH", "class_name": "AssistantAuth" },
      { "name": "ASSISTANT_USERS", "class_name": "AssistantUser" }
    ] },
    "unsafe": { "bindings": [{ "name": "AUTH_RATE_LIMIT", "type": "ratelimit", "namespace_id": "4102", "simple": { "limit": 10, "period": 60 } }] }
  } }
}
