    "ajv": "^8.20.0",
    "js-yaml": "^4.3.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.103.0"
  },
  "packageManager": "pnpm@11.0.8"
