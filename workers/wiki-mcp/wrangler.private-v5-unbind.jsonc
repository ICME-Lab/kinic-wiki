{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kinic-wiki-mcp-private",
  "main": "src/v5-unbind.ts",
  "compatibility_date": "2026-05-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "wiki-private-mcp.kinic.xyz", "custom_domain": true }],
  "ratelimits": [
    {
      "name": "MCP_REGISTRATION_RATE_LIMIT",
      "namespace_id": "7802027",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "MCP_REVIEW_LOGIN_RATE_LIMIT",
      "namespace_id": "7802029",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["McpAuthStateV4"] }],
  "vars": {
    "KINIC_WIKI_CANISTER_ID": "6emaw-iyaaa-aaaay-aacka-cai",
    "KINIC_WIKI_IC_HOST": "https://icp0.io",
    "KINIC_WIKI_MCP_TARGET_ORIGIN": "https://6emaw-iyaaa-aaaay-aacka-cai.ic0.app",
    "KINIC_WIKI_PUBLIC_ORIGIN": "https://wiki.kinic.xyz",
    "MCP_ACCESS_POLICY": "private_required",
    "MCP_WRITE_POLICY": "private",
    "MCP_PUBLIC_ORIGIN": "https://wiki-private-mcp.kinic.xyz",
    "MCP_REVIEW_LOGIN_ENABLED": "true",
    "MCP_REVIEW_ACCESS_VERSION": "review-v1",
    "MCP_REVIEW_WRITE_PREFIX": "/OpenAIReview/scratch",
    "OPENAI_APPS_CHALLENGE_TOKEN": "eegi6ZKN5pqSVhGk_gLEED4Xa7R5gwHfYc5ej5v8Mj0"
  }
}
