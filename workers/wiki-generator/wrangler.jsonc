{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kinic-wiki-generator",
  "account_id": "9029b5f9de5b2e820eaf4ed562bcb0e7",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "wiki-generator.kinic.xyz",
      "custom_domain": true
    }
  ],
  "vars": {
    "KINIC_WIKI_CANISTER_ID": "6emaw-iyaaa-aaaay-aacka-cai",
    "KINIC_WIKI_IC_HOST": "https://icp0.io",
    "KINIC_WIKI_WORKER_MODEL": "deepseek-v4-flash",
    "KINIC_WIKI_WORKER_TARGET_ROOT": "/Knowledge/conversations",
    "KINIC_WIKI_WORKER_SOURCE_PREFIX": "/Sources",
    "KINIC_WIKI_WORKER_CONTEXT_PREFIX": "/"
  },
  "services": [
    {
      "binding": "NNS_PROPOSAL_REVIEW_SERVICE",
      "service": "kinic-nns-proposal-review"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinic-wiki-generator",
      "database_id": "c82cdeed-424c-474a-8552-23b2b7e74a7a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LINK_PREVIEW_IMAGES",
      "bucket_name": "kinic-wiki-link-preview-images"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WIKI_GENERATION_QUEUE",
        "queue": "kinic-wiki-generation"
      },
      {
        "binding": "WIKI_GENERATION_DLQ",
        "queue": "kinic-wiki-generation-failures"
      }
    ],
    "consumers": [
      {
        "queue": "kinic-wiki-generation",
        "max_batch_size": 4,
        "max_batch_timeout": 1,
        "max_concurrency": 5,
        "max_retries": 5
      }
    ]
  }
}
