{
  "name": "kinic-wiki-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:nns": "wrangler deploy --dry-run --config wrangler.nns.jsonc",
    "cf-typegen": "wrangler types --include-runtime false --env-interface Env src/worker-configuration.d.ts",
    "cf-typegen:nns": "wrangler types --config wrangler.nns.jsonc --include-runtime false --env-interface NnsWorkerBindings src/nns-worker-configuration.d.ts",
    "cf-typecheck": "wrangler types --include-runtime false --env-interface Env src/worker-configuration.d.ts --check",
    "cf-typecheck:nns": "wrangler types --config wrangler.nns.jsonc --include-runtime false --env-interface NnsWorkerBindings src/nns-worker-configuration.d.ts --check",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:nns": "pnpm run build:nns && wrangler deploy --config wrangler.nns.jsonc",
    "dev": "wrangler dev --test-scheduled",
    "dev:nns": "wrangler dev --config wrangler.nns.jsonc --test-scheduled",
    "test": "node scripts/check-candid-drift.mjs && tsc -p tsconfig.test.json && node --test .tmp-test/tests/*.test.js",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:worker:nns": "vitest run --config vitest.nns-worker.config.ts",
    "typecheck": "tsc --noEmit",
    "audit:moderate": "pnpm audit --audit-level moderate"
  },
  "dependencies": {
    "@icp-sdk/core": "^5.4.0",
    "@kinic/source-contracts": "workspace:*",
    "@kinic/vfs-client-core": "workspace:*",
    "@resvg/resvg-wasm": "2.4.1",
    "satori": "0.29.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "4.20260702.1",
    "@kinic/candid-tools": "workspace:*",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "^3.2.4",
    "wrangler": "4.110.0"
  },
  "pnpm": {
    "overrides": {
      "ws": "8.21.0"
    }
  },
  "packageManager": "pnpm@11.0.8"
}
