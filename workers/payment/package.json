{
  "name": "kinic-payment-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface PaymentBindings worker-configuration.d.ts",
    "cf-typecheck": "wrangler types --env-interface PaymentBindings worker-configuration.d.ts --check",
    "deploy": "wrangler deploy --config wrangler.production.jsonc",
    "dev": "wrangler dev --config wrangler.jsonc",
    "test": "tsc -p tsconfig.test.json && node --test .tmp-test/tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@icp-sdk/core": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "wrangler": "^4.103.0"
  },
  "packageManager": "pnpm@11.0.8"
}
