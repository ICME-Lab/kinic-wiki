{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "typeRoots": ["../wiki-generator/node_modules/@types"],
    "noEmit": false,
    "outDir": ".tmp-test",
    "rootDir": "."
