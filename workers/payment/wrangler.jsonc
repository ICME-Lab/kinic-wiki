{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kinic-payment-dev",
  "account_id": "9029b5f9de5b2e820eaf4ed562bcb0e7",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "KINIC_WIKI_CANISTER_ID": "6emaw-iyaaa-aaaay-aacka-cai",
    "KINIC_WIKI_IC_HOST": "https://icp0.io",
    "APP_STORE_ENVIRONMENT": "Sandbox",
    "APP_STORE_BUNDLE_ID": "xyz.kinic.ios.KinicWiki",
    "APP_STORE_NOTIFICATION_ROOT_SHA256": "local-notification-root-sha256",
    "IAP_PRODUCT_CATALOG_JSON": "{\"xyz.kinic.dbcredits.small\":\"1825000000000\",\"xyz.kinic.dbcredits.medium\":\"1200000000000\",\"xyz.kinic.dbcredits.large\":\"4000000000000\"}"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinic-payment-dev",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "IAP_GLOBAL_RATE_LIMITER",
      "namespace_id": "11001",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "IAP_PRINCIPAL_RATE_LIMITER",
      "namespace_id": "11002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
