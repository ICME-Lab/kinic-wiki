    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "10.4.22",
    "jsdom": "30.0.1",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.18",
