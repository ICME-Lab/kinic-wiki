{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "fixtures/main.tsx",
    "fixtures/network.ts",
    "fixtures/acceptance-readback.ts",
    "fixtures/vite.config.ts"
  ]
}
