type AutoTopupPolicy = record {
  // The most this policy may send per UTC day.
  daily_limit_cycles : nat64;
  // A refill may run only while the Vault balance is below this.
  threshold_cycles : nat64;
  // The owned Wiki database that pays for refills.
  database_id : text;
  // Cycles sent per refill.
  amount_cycles : nat64;
  // The database keeps at least this after a refill and its fee.
  min_database_cycles : nat64;
};
type AutoTopupStatus = record {
  sent_today_cycles : nat64;
  last_topup_at_ns : opt nat64;
  database_name : text;
  policy : AutoTopupPolicy;
};
type BridgeError = variant {
  Storage;
  InvalidInput;
  Disabled;
  NotFound;
  Unauthorized;
  Capacity;
  Unavailable;
  Expired;
  Conflict;
};
type BridgeRevocation = record {
  through_generation : nat64;
  vault_owner : principal;
};
type CreditOffer = record {
  wiki_owner : principal;
  link_generation : nat64;
  operation : blob;
  amount_cycles : nat64;
  vault_owner : principal;
  expires_at_ns : nat64;
};
type CreditReceipt = record { status : CreditStatus; offer : CreditOffer };
type CreditStatus = variant { Prepared; Accepted; NotAccepted };
type LinkChallenge = record {
  challenge : blob;
  generation : nat64;
  vault_owner : principal;
  expires_at_ns : nat64;
};
type LinkStatus = record {
  wiki_owner : principal;
  active : bool;
  generation : nat64;
  vault_owner : principal;
};
type Result_2 = variant { Ok : LinkChallenge; Err : BridgeError };
type Result_27 = variant { Ok : CreditReceipt; Err : BridgeError };
type Result_29 = variant { Ok : opt CreditReceipt; Err : BridgeError };
type Result_30 = variant { Ok : BridgeRevocation; Err : BridgeError };
type Result_32 = variant { Ok : opt AutoTopupStatus; Err : BridgeError };
type Result_33 = variant { Ok : opt LinkStatus; Err : BridgeError };
service : {
  begin_wiki_link : (blob) -> (Result_2);
  prepare_wiki_credit : (blob) -> (Result_27);
  request_wiki_auto_topup : () -> (Result_29);
  revoke_wiki_link : () -> (Result_30);
  wiki_auto_topup_status : () -> (Result_32);
  wiki_link_status : () -> (Result_33);
}
