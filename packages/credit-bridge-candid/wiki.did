type AutoTopupPolicy = record {
  // The most this policy may send per UTC day.
  daily_limit_cycles : nat64;
  // A refill may run only while the Vault balance is below this.
  threshold_cycles : nat64;
  // The owned Wiki database that pays for refills.
  database_id : text;
  // Cycles sent per refill.
  amount_cycles : nat64;
  // The database keeps at least this after a refill and its fee.
  min_database_cycles : nat64;
};
type AutoTopupStatus = record {
  sent_today_cycles : nat64;
  last_topup_at_ns : opt nat64;
  database_name : text;
  policy : AutoTopupPolicy;
};
type BridgeError = variant {
  Storage;
  InvalidInput;
  Disabled;
  NotFound;
  Unauthorized;
  Capacity;
  Unavailable;
  Expired;
  Conflict;
};
type CreditOffer = record {
  wiki_owner : principal;
  link_generation : nat64;
  operation : blob;
  amount_cycles : nat64;
  vault_owner : principal;
  expires_at_ns : nat64;
};
type LinkChallenge = record {
  challenge : blob;
  generation : nat64;
  vault_owner : principal;
  expires_at_ns : nat64;
};
type LinkStatus = record {
  wiki_owner : principal;
  active : bool;
  generation : nat64;
  vault_owner : principal;
};
type Result_1 = variant { Ok : LinkStatus; Err : BridgeError };
type Result_21 = variant { Ok : opt VaultTransfer; Err : BridgeError };
type Result_22 = variant { Ok : opt AutoTopupStatus; Err : BridgeError };
type Result_5 = variant { Ok : opt LinkStatus; Err : BridgeError };
type Result_50 = variant { Ok : LinkChallenge; Err : BridgeError };
type Result_6 = variant { Ok : VaultTransfer; Err : BridgeError };
type Result_61 = variant { Ok; Err : BridgeError };
type TransferAmount = variant { All; Exact : nat64 };
type TransferApproval = variant { Exact : nat64; AllAvailable };
type TransferPhase = variant { Quoted; Refunded; Paid; Offered; Unknown };
type VaultTransfer = record {
  requested : TransferAmount;
  offer : CreditOffer;
  receiver_cleanup_pending : bool;
  balance_at_quote : nat64;
  database_id : text;
  phase : TransferPhase;
  collected_execution_fee_cycles : nat64;
  estimated_execution_fee_cycles : nat64;
};
service : {
  approve_vault_link : (blob) -> (Result_1);
  cancel_vault_transfer : (blob) -> (Result_6);
  execute_vault_transfer : (blob, TransferApproval) -> (Result_6);
  get_pending_vault_transfer : (opt text) -> (Result_21);
  get_vault_auto_topup : () -> (Result_22) query;
  get_vault_link : () -> (Result_5) query;
  get_vault_transfer : (blob) -> (Result_6);
  preview_vault_link : (blob) -> (Result_50);
  quote_vault_transfer : (text, TransferAmount, blob) -> (Result_6);
  reconcile_vault_transfer : (blob) -> (Result_6);
  revoke_vault_link : () -> (Result_61);
  set_vault_auto_topup : (opt AutoTopupPolicy) -> (Result_22);
}
